# ---------------------------------------------------------------------------
# Media Server API — configuration
# Copy this file to `.env` and adjust for the target machine.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- API / server -----------------------------------------------------------
APP_NAME="Dell Media Server"
APP_ENV=development           # development | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Comma-separated CORS origins for the mobile app. Use "*" for LAN-only.
# For remote access, list explicit origins e.g. "http://localhost:5173,https://myapp.example".
ALLOWED_ORIGINS=*

# --- Control actions (/api/v1/actions/*) ------------------------------------
# Shared secret required as the X-API-Key header on every /actions/* route
# (add torrent, sync-movies). Leave empty to keep control endpoints disabled
# (they return 503 rather than opening up unauthenticated).
ACTIONS_API_KEY=

# Existing shell script that moves completed downloads into the movies
# library; POST /api/v1/actions/sync-movies just runs it.
SYNC_MOVIES_SCRIPT_PATH=/usr/local/bin/sync-movies
SYNC_MOVIES_TIMEOUT=120

# Max accepted size (MB) for an uploaded .torrent file.
TORRENT_FILE_MAX_MB=10

# Seconds between torrent-list pushes on GET /api/v1/torrents/ws.
TORRENTS_WS_INTERVAL=2

# --- qBittorrent Web API ----------------------------------------------------
# Enable the Web UI in qBittorrent: Tools > Options > Web UI.
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
QBITTORRENT_TIMEOUT=10

# --- Storage layout (Dell paths) -------------------------------------------
MEDIA_ROOT=/srv/storage/media
MOVIES_PATH=/srv/storage/media/movies
SHOWS_PATH=/srv/storage/media/shows
DOWNLOADS_ROOT=/srv/storage/downloads
TORRENTS_COMPLETE_PATH=/srv/storage/downloads/torrents/complete
TORRENTS_INCOMPLETE_PATH=/srv/storage/downloads/torrents/incomplete

# Filesystems to report in /storage/summary (comma-separated absolute paths).
MONITORED_PATHS=/srv/storage,/srv/storage/media,/srv/storage/downloads

# Block device for SMART health (e.g. /dev/sda). Leave empty to disable.
SMART_DEVICE=

# --- Services (systemd unit names) ------------------------------------------
MONITORED_SERVICES=jellyfin,qbittorrent-nox,smbd,ssh

# --- Library scanning -------------------------------------------------------
MEDIA_EXTENSIONS=.mkv,.mp4,.avi,.mov,.m4v,.wmv,.flv,.webm,.ts,.m2ts

# --- Library artwork (posters / thumbnails) ---------------------------------
# Preferred source: proxy posters Jellyfin already scraped. Set BOTH values to
# enable. Leave either empty to disable Jellyfin and fall back to local artwork
# files (poster.jpg / folder.jpg / cover.jpg next to each title). If neither is
# available the API returns poster_url: null and the app shows its placeholder.
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=
# Seconds to cache the folder->Jellyfin item mapping (the list path never hits
# Jellyfin per request; it only reads this cache).
JELLYFIN_MAP_TTL=300

# Local artwork filenames looked up next to each title, in order.
ARTWORK_FILENAMES=poster.jpg,poster.png,poster.webp,folder.jpg,folder.png,cover.jpg,cover.png
# Cache TTL (seconds) for the per-folder local-artwork existence check.
ARTWORK_LOCAL_TTL=300
# Downscale targets — never ship full-res art to a phone.
ARTWORK_POSTER_MAX_HEIGHT=500
ARTWORK_THUMB_MAX_HEIGHT=200
ARTWORK_JPEG_QUALITY=80
# Max downscaled images kept in the in-memory byte cache.
ARTWORK_CACHE_MAX_ITEMS=256
